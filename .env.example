# AID-LLM-connector Configuration

# Method 1: Direct Firebase ID Token or Access Token (recommended for zero-credential safety)
# You can copy this from your browser DevTools (Network tab -> Authorization header)
# or via AID-QoL-Tool export.
AID_ACCESS_TOKEN=

# Method 2: Firebase Email & Password (optional, for headless automated sign-in)
AID_EMAIL=
AID_PASSWORD=

# Optional Overrides (defaults to production AI Dungeon endpoints)
AID_GRAPHQL_ENDPOINT=https://api.aidungeon.com/graphql
AID_DEFAULT_SCENARIO_ID=
AID_DEFAULT_ADVENTURE_ID=
